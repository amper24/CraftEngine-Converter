{
  "domain": "functions",
  "version": "26.8",
  "description": "Confirmed event function types grouped by category.",
  "source": "https://xiao-momi.github.io/craft-engine-wiki/reference/events/",
  "categories": {
    "flow": ["cancel_event", "run", "if_else", "when"],
    "messaging": ["message", "actionbar", "title"],
    "world_block": ["break_block", "place_block", "update_block_property", "transform_block", "drop_loot", "update_interaction_tick", "cycle_block_property"],
    "items_player": ["set_count", "damage_item", "potion_effect", "remove_potion_effect", "set_cooldown", "remove_cooldown", "set_exp", "set_level", "play_totem_animation"],
    "audio_effects_integration": ["play_sound", "particle", "cast_mythic_skill", "teleport"],
    "furniture_entity_ui": ["spawn_furniture", "remove_furniture", "replace_furniture", "rotate_furniture", "remove_entity", "open_window", "merchant_trade"]
  },
  "open_window_gui_types": ["anvil", "enchantment", "grindstone", "loom", "smithing", "crafting", "cartography"],
  "function_bodies": {
    "cancel_event": {},
    "message": { "message": "string", "target": "self", "overlay": "bool" },
    "actionbar": { "actionbar": "string", "target": "self" },
    "title": { "title": "string", "subtitle": "string", "fade_in": 20, "stay": 10, "fade_out": 10 },
    "command": { "command": "string", "target": "self", "as_player": false, "as_op": false, "as_event": false },
    "run": { "delay": 0, "functions": ["..."] },
    "if_else": { "rules": [] },
    "when": { "source": "<papi:player_world>", "cases": [{ "when": "world", "functions": [] }], "fallback": [] },
    "break_block": { "x": 0, "y": 0, "z": 0 },
    "place_block": { "block_state": "default:chinese_lantern", "x": 0, "y": 0, "z": 0 },
    "update_block_property": { "properties": {} },
    "transform_block": { "block": "default:palm_log", "properties": {} },
    "drop_loot": { "to_inventory": false, "loot": {} },
    "set_count": { "add": true, "count": -1, "target": "self" },
    "damage_item": { "amount": 1 },
    "potion_effect": { "potion_effect": "minecraft:blindness", "duration": 20, "amplifier": 0, "ambient": false, "particles": true, "show_icon": true },
    "remove_potion_effect": { "potion_effect": "minecraft:blindness" },
    "set_cooldown": { "time": "1m30s", "id": "my_cooldown_id", "add": false },
    "remove_cooldown": { "id": "my_cooldown_id" },
    "set_exp": { "amount": 0 },
    "set_level": { "level": 0 },
    "play_totem_animation": {},
    "play_sound": { "sound": "minecraft:block.note_block.bell", "target": "self", "pitch": 1, "volume": 1, "source": "master" },
    "teleport": { "destination": "..." },
    "spawn_furniture": {},
    "remove_furniture": {},
    "replace_furniture": {},
    "rotate_furniture": { "on_success": [], "on_failure": [] },
    "remove_entity": {},
    "open_window": { "gui_type": "anvil" },
    "merchant_trade": {}
  },
  "security_note": "command.as_op is documented as a potential security risk; prefer console execution where appropriate."
}