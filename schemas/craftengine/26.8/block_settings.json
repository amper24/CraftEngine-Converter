{
  "domain": "block_settings",
  "version": "26.8",
  "description": "Block settings registered by BlockSettingsModifiers in CraftEngine 26.8. snake_case canonical keys only.",
  "source": "https://github.com/Xiao-MoMi/craft-engine/blob/main/core/src/main/java/net/momirealms/craftengine/core/block/setting/BlockSettingsModifiers.java",
  "stable": [
    { "name": "item", "type": "string", "required": false, "description": "Associated block item ID (block -> item lookup)." },
    { "name": "name", "type": "string", "description": "Block display name (for non-item blocks)." },
    { "name": "support_shape", "type": "string", "default": null, "description": "Support shape source block state." },
    { "name": "luminance", "type": "int", "default": 0, "description": "Block light level." },
    { "name": "map_color", "type": "string|int", "default": 0, "description": "Map color." },
    { "name": "burn_chance", "type": "int", "default": 0, "description": "Ignite chance." },
    { "name": "fire_spread_chance", "type": "int", "default": 0, "description": "Fire spreading chance." },
    { "name": "block_light", "type": "int", "default": 0, "description": "Block light emission." },
    { "name": "light_block", "type": "int", "default": 0, "description": "Light block value." },
    { "name": "light_dampening", "type": "int", "default": 15, "description": "Light dampening." },
    { "name": "hardness", "type": "float", "default": 2.0, "description": "Break duration." },
    { "name": "friction", "type": "float", "default": 0.6, "description": "Block friction." },
    { "name": "speed_factor", "type": "float", "default": 1.0, "description": "Movement speed factor." },
    { "name": "jump_factor", "type": "float", "default": 1.0, "description": "Jump factor." },
    { "name": "resistance", "type": "float", "default": 2.0, "description": "Explosion resistance." },
    { "name": "incorrect_tool_dig_speed", "type": "float", "default": 0.3, "description": "Speed multiplier for wrong tool. Range 0..1." },
    { "name": "replaceable", "type": "boolean", "default": false, "description": "Replaceable block." },
    { "name": "is_redstone_conductor", "type": "string", "default": "UNDEFINED", "enum": ["TRUE", "FALSE", "UNDEFINED"] },
    { "name": "is_suffocating", "type": "string", "default": "UNDEFINED", "enum": ["TRUE", "FALSE", "UNDEFINED"] },
    { "name": "is_randomly_ticking", "type": "boolean", "default": false, "description": "Whether block randomly ticks." },
    { "name": "is_view_blocking", "type": "string", "default": "UNDEFINED", "enum": ["TRUE", "FALSE", "UNDEFINED"] },
    { "name": "propagate_skylight", "type": "boolean", "default": false, "description": "Whether the block propagates skylight." },
    { "name": "burnable", "type": "boolean", "default": false, "description": "Whether block can be set on fire." },
    { "name": "push_reaction", "type": "string", "default": "NORMAL", "enum": ["NORMAL", "DESTROY", "BLOCK", "IGNORE", "PUSH_ONLY", "NORMAL_ONLY"], "description": "Piston behavior." },
    { "name": "instrument", "type": "string", "default": "harp", "description": "Note block instrument." },
    { "name": "sounds", "type": "mapping", "default": null, "description": "Block sound set (break/step/place/hit/fall), each string or {id,pitch,volume}." },
    { "name": "fluid_state", "type": "string", "default": "empty", "description": "Fluid state." },
    { "name": "can_occlude", "type": "boolean", "default": false, "description": "Whether block can occlude." },
    { "name": "require_correct_tools", "type": "boolean", "default": false, "description": "Correct tool required for drop." },
    { "name": "respect_tool_component", "type": "boolean", "default": false, "description": "Respect minecraft:tool.correct_for_drops component." },
    { "name": "required_break_power", "type": "int", "default": 0, "description": "Minimum break power required." },
    { "name": "use_shape_for_light_occlusion", "type": "boolean", "default": false, "description": "Use block shape for light occlusion." },
    { "name": "tags", "type": "list", "default": null, "description": "Block tags." },
    { "name": "correct_tools", "type": "list", "default": null, "description": "Whitelist of correct tool ids." },
    { "name": "block_raytrace", "type": "boolean", "default": true, "description": "Whether the block blocks ray-tracing." },
    { "name": "bounce_restitution", "type": "float", "default": 0.5, "description": "Bounce restitution." },
    { "name": "destroy_stages", "type": "mapping", "default": null, "description": "Custom mining crack display items and offsets." }
  ],
  "unstable": [],
  "client_bound_tags": { "name": "client_bound_tags", "type": "list", "description": "Client-side vanilla block tags (vanilla block overrides)." },
  "sound_keys": ["fall", "hit", "break", "step", "place"],
  "burn_sound_note": "Burnable blocks usually need fire_spread_chance and burn_chance."
}
