{
  "domain": "item_data",
  "version": "26.8",
  "description": "ItemStack data-component layer. snake_case canonical keys. Repeated processors may use #<id> suffix.",
  "source": "https://xiao-momi.github.io/craft-engine-wiki/configuration/item/data/",
  "data_keys": [
    { "name": "item_name", "type": "string", "description": "Default item display name." },
    { "name": "display_name", "type": "string", "description": "Alias of item_name." },
    { "name": "custom_name", "type": "string", "description": "Player/custom override name." },
    { "name": "lore", "type": "list|mapping", "description": "Item lore lines." },
    { "name": "insert_lore", "type": "mapping", "description": "Insert strings into existing lore." },
    { "name": "remove_lore", "type": "string|list", "description": "Remove lore lines matching regex." },
    { "name": "tooltip_style", "type": "string", "description": "Tooltip background texture (1.21.2+)." },
    { "name": "hide_tooltip", "type": "list", "description": "Hide tooltip component groups." },
    { "name": "dyed_color", "type": "string|list", "description": "RGB color as r,g,b or int." },
    { "name": "trim", "type": "mapping", "description": "Armor trim {pattern, material}." },
    { "name": "custom_model_data", "type": "int", "description": "Component value (does not bind model by itself)." },
    { "name": "item_model", "type": "string", "description": "item_model component value." },
    { "name": "profile", "type": "string|mapping", "description": "Player-head profile/texture." },
    { "name": "food", "type": "mapping", "description": "Food data {nutrition, saturation, can_always_eat}." },
    { "name": "consumable", "type": "mapping", "description": "Consumable component (required for edible food on 1.20.5+)." },
    { "name": "equippable", "type": "mapping", "description": "Equipment component (1.21.2+)." },
    { "name": "use_remainder", "type": "mapping|string", "description": "Remainder after use (1.21.2+)." },
    { "name": "unbreakable", "type": "boolean", "description": "Unbreakable component." },
    { "name": "max_damage", "type": "int", "description": "Durability cap (1.20.5+)." },
    { "name": "attribute_modifiers", "type": "list", "description": "Attribute modifiers." },
    { "name": "attributes", "type": "list", "description": "Alias of attribute_modifiers." },
    { "name": "enchantment", "type": "mapping", "description": "Enchantments." },
    { "name": "painting_variant", "type": "string", "description": "Painting variant." },
    { "name": "jukebox_playable", "type": "string", "description": "Jukebox song (1.21+)." },
    { "name": "block_state", "type": "mapping|string", "description": "Placement block state." },
    { "name": "blockstate", "type": "mapping|string", "description": "Alias of block_state." },
    { "name": "pdc", "type": "mapping", "description": "Persistent custom data key/value." },
    { "name": "tags", "type": "mapping", "description": "Low-level NBT (in data context)." },
    { "name": "nbt", "type": "mapping", "description": "Low-level NBT access." },
    { "name": "written_book_content", "type": "mapping", "description": "Written book." },
    { "name": "random_values", "type": "mapping", "description": "Persisted random values." },
    { "name": "external", "type": "mapping", "description": "External plugin item source." },
    { "name": "components", "type": "mapping", "description": "Raw custom data components (fragile layer)." },
    { "name": "remove_components", "type": "list", "description": "Remove data components." },
    { "name": "client_bound_data", "type": "mapping", "description": "Per-client display data (Premium)." }
  ],
  "attribute_modifier_fields": {
    "type": "attribute id e.g. attack_damage",
    "amount": "number",
    "operation": "add_value|add_multiplied_base|add_multiplied_total",
    "id": "namespace:custom_attribute",
    "slot": "mainhand|offhand|head|chest|legs|feet|body|any"
  },
  "food_fields": { "nutrition": "int", "saturation": "float", "can_always_eat": "bool" },
  "equippable_fields": {
    "slot": "head|chest|legs|feet|body|mainhand|offhand|saddle",
    "asset_id": "minecraft:topaz",
    "camera_overlay": "namespace:id",
    "swappable": "bool",
    "damage_on_hurt": "bool",
    "dispensable": "bool",
    "equip_on_interact": "bool (1.21.5+)"
  },
  "repeated_processor_rule": "Append #<id> to a data key when the same processor is applied more than once; suffix stripped during parsing.",
  "item_name_vs_custom_name": "item_name is base name, not erased by anvil and not italic by default; custom_name has higher display priority."
}