    "wall_torch_particle_block"
  ],
  "behavior_dependencies": {
    "button_block": {
      "required_properties": ["powered"],
      "note": "powered:boolean; face/facing come from face_attached_horizontal_directional_block when directed output is needed.",
      "composite_hint": ["face_attached_horizontal_directional_block"]
    },
    "crop_block": {
      "required_properties": ["age"],
      "note": "age: integer crop growth stage."
    },
    "door_block": {
      "required_properties": ["hinge"],
      "note": "hinge: hinge enum; door usually also needs half and facing via door placement."
    }
  },
  "composite_rule": "Merge all required properties from all behaviors; inspect combinations for conflicts.",
  "property_names_hardcoded": true
}