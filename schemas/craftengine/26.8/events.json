{
  "domain": "events",
  "version": "26.8",
  "description": "Event entries DSL. Canonical form: list of {on, functions, conditions}.",
  "source": "https://xiao-momi.github.io/craft-engine-wiki/reference/events/",
  "structure": {
    "form": "list",
    "entry": { "on": "string|list", "functions": "list", "conditions": "list (optional)" }
  },
  "triggers": {
    "items": ["break", "right_click", "left_click", "consume", "pick_up", "attack"],
    "blocks": ["break", "place", "right_click", "left_click", "step"],
    "furniture": ["break", "place", "right_click"]
  },
  "note": "Event must live in the config domain of the object that actually receives interaction.",
  "example": {
    "events": [
      {
        "on": "right_click",
        "functions": [
          {
            "type": "command",
            "command": "say hello",
            "conditions": [{ "type": "permission", "permission": "craftengine.admin" }]
          }
        ]
      }
    ]
  }
}