{
  "domain": "events",
  "version": "26.8",
  "description": "Event entries DSL. Canonical form: list of {on, functions, conditions}.",
  "source": "https://ce-pre.gtemc.cn/reference/events",
  "structure": {
    "form": "list",
    "entry": {
      "on": "string|list",
      "functions": "list",
      "conditions": "list (optional)"
    }
  },
  "triggers": {
    "items": [
      "item_break",
      "block_break",
      "right_click",
      "left_click",
      "consume",
      "pick_up",
      "attack"
    ],
    "blocks": [
      "block_break",
      "place",
      "right_click",
      "left_click",
      "step"
    ],
    "furniture": [
      "furniture_break",
      "place",
      "right_click"
    ]
  },
  "note": "Event must live in the config domain of the object that actually receives interaction. Trigger names verified against ce-pre.gtemc.cn/reference/events, which uses domain-specific break triggers (item_break / block_break / furniture_break).",
  "example": {
    "events": [
      {
        "on": "right_click",
        "functions": [
          {
            "type": "command",
            "command": "say hello",
            "conditions": [
              {
                "type": "permission",
                "permission": "craftengine.admin"
              }
            ]
          }
        ]
      }
    ]
  }
}
